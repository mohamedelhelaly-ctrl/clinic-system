{
  "name": "clinic-system",
  "private": true,
  "description": "Clinic management system for private clinics in Egypt (demo build).",
  "workspaces": [
    "apps/web",
    "demo-recording"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "test": "npm run test -w apps/web",
    "lint": "npm run lint -w apps/web && prettier --check .",
    "typecheck": "npm run typecheck -w apps/web",
    "format": "prettier --write .",
    "demo:reset": "npm run dev -w apps/web -- --open /?reset=1",
    "record": "npm run record -w demo-recording"
  },
  "devDependencies": {
    "prettier": "3.9.10"
  }
}
